{
  "name": "@sun/core",
  "version": "0.11.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings-preferences": {
      "types": "./dist/settings/preferences.d.ts",
      "default": "./dist/settings/preferences.js"
    },
    "./settings-protocol": {
      "types": "./dist/settings/protocol.d.ts",
      "default": "./dist/settings/protocol.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
