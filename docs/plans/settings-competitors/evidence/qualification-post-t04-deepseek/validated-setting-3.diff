+// Accept only a non-empty decimal digit string: no sign, fraction, exponent or padding.
+const decimalDigits = /^[0-9]+$/;
+
 export function edit(host, key, raw) {
   if (key === 'verbose' && (raw === 'true' || raw === 'false')) {
     return host.update(host.get().revision, { [key]: raw === 'true' });
   }
+  if (key === 'pageSize' && typeof raw === 'string' && decimalDigits.test(raw)) {
+    // Range is enforced by the host through checks.pageSize; invalid values
+    // return INVALID without mutating values or revision.
+    return host.update(host.get().revision, { [key]: Number(raw) });
+  }
   return { ok: false, code: 'INVALID', key };
 }
