--- a/src/cli.mjs
+++ b/src/cli.mjs
@@ -2,5 +2,13 @@ export function edit(host, key, raw) {
   if (key === 'verbose' && (raw === 'true' || raw === 'false')) {
     return host.update(host.get().revision, { [key]: raw === 'true' });
   }
+  if (key === 'pageSize') {
+    if (typeof raw !== 'string' || !/^[0-9]+$/.test(raw)) return { ok: false, code: 'INVALID', key };
+    const pageSize = Number(raw);
+    if (!Number.isSafeInteger(pageSize) || pageSize < 10 || pageSize > 100) {
+      return { ok: false, code: 'INVALID', key };
+    }
+    return host.update(host.get().revision, { [key]: pageSize });
+  }
   return { ok: false, code: 'INVALID', key };
 }
