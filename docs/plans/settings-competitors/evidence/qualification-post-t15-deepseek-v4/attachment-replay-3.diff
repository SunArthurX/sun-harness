diff --git a/src/replay.mjs b/src/replay.mjs
index c831dac..d6421a9 100644
--- a/src/replay.mjs
+++ b/src/replay.mjs
@@ -3,12 +3,18 @@ export function replay(events, readAttachment) {
   for (const event of events) {
     if (event.type === 'assistant') messages.push({ role: 'assistant', text: event.text, images: [] });
     if (event.type !== 'user') continue;
-    try {
-      const images = (event.attachments ?? []).map(path => readAttachment(path));
-      messages.push({ role: 'user', text: event.text, images });
-    } catch (error) {
-      if (error.code !== 'ENOENT') throw error;
+    const images = [];
+    let missing = 0;
+    for (const path of event.attachments ?? []) {
+      try {
+        images.push(readAttachment(path));
+      } catch (error) {
+        if (error.code !== 'ENOENT') throw error;
+        missing += 1;
+      }
     }
+    const text = missing === 0 ? event.text : `${event.text}\n[Missing attachments: ${missing}]`;
+    messages.push({ role: 'user', text, images });
   }
   return messages;
 }
diff --git a/test/additions.test.mjs b/test/additions.test.mjs
new file mode 100644
index 0000000..d22ddeb
--- /dev/null
+++ b/test/additions.test.mjs
@@ -0,0 +1,97 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { replay } from '../src/replay.mjs';
+
+function enoent(path) {
+  const error = new Error(`ENOENT: no such file or directory, open '${path}'`);
+  error.code = 'ENOENT';
+  return error;
+}
+
+test('missing attachment keeps ordered images and appends marker', () => {
+  const byPath = { a: 'img-a', c: 'img-c' };
+  const events = [{ type: 'user', text: 'hello', attachments: ['a', 'b', 'c'] }];
+  const result = replay(events, path => {
+    if (byPath[path] === undefined) throw enoent(path);
+    return byPath[path];
+  });
+  assert.deepEqual(result, [{ role: 'user', text: 'hello\n[Missing attachments: 1]', images: ['img-a', 'img-c'] }]);
+});
+
+test('missing attachment marker counts every missing attachment', () => {
+  const events = [{ type: 'user', text: 'hello', attachments: ['missing-1', 'missing-2'] }];
+  const result = replay(events, path => {
+    throw enoent(path);
+  });
+  assert.deepEqual(result, [{ role: 'user', text: 'hello\n[Missing attachments: 2]', images: [] }]);
+});
+
+test('user event without attachments is preserved', () => {
+  const events = [{ type: 'user', text: 'plain' }];
+  assert.deepEqual(replay(events, () => assert.fail('reader must not be called')), [
+    { role: 'user', text: 'plain', images: [] },
+  ]);
+});
+
+test('user and assistant events replay in order', () => {
+  const events = [
+    { type: 'user', text: 'first', attachments: ['a'] },
+    { type: 'assistant', text: 'reply' },
+    { type: 'user', text: 'second', attachments: ['gone'] },
+    { type: 'system', text: 'ignored' },
+    { type: 'assistant', text: 'second reply' },
+  ];
+  const result = replay(events, path => {
+    if (path === 'gone') throw enoent(path);
+    return 'img-a';
+  });
+  assert.deepEqual(result, [
+    { role: 'user', text: 'first', images: ['img-a'] },
+    { role: 'assistant', text: 'reply', images: [] },
+    { role: 'user', text: 'second\n[Missing attachments: 1]', images: [] },
+    { role: 'assistant', text: 'second reply', images: [] },
+  ]);
+});
+
+test('non-ENOENT reader errors propagate', () => {
+  const failure = new Error('permission denied');
+  failure.code = 'EACCES';
+  assert.throws(
+    () => replay([{ type: 'user', text: 'hello', attachments: ['a'] }], () => {
+      throw failure;
+    }),
+    error => error === failure,
+  );
+});
+
+test('thrown non-ENOENT error without code propagates', () => {
+  assert.throws(
+    () => replay([{ type: 'user', text: 'hello', attachments: ['a'] }], () => {
+      throw new Error('boom');
+    }),
+    { message: 'boom' },
+  );
+});
+
+test('event array and event objects are not mutated', () => {
+  const attachments = ['a', 'missing'];
+  const events = [{ type: 'user', text: 'hello', attachments }];
+  const snapshot = JSON.parse(JSON.stringify(events));
+  replay(events, path => {
+    if (path === 'missing') throw enoent(path);
+    return 'img-a';
+  });
+  assert.deepEqual(events, snapshot);
+  assert.equal(events[0].attachments, attachments);
+});
+
+test('repeated replay of the same events is stable', () => {
+  const events = [{ type: 'user', text: 'hello', attachments: ['missing'] }];
+  const reader = path => {
+    throw enoent(path);
+  };
+  const first = replay(events, reader);
+  const second = replay(events, reader);
+  assert.deepEqual(first, second);
+  assert.deepEqual(first, [{ role: 'user', text: 'hello\n[Missing attachments: 1]', images: [] }]);
+});
