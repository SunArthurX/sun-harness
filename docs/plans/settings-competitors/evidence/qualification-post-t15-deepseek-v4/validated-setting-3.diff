+import { checks } from './schema.mjs';
+
 export function edit(host, key, raw) {
   if (key === 'verbose' && (raw === 'true' || raw === 'false')) {
     return host.update(host.get().revision, { [key]: raw === 'true' });
   }
+  // Decimal digit strings only: no sign, whitespace, separator or exponent.
+  if (key === 'pageSize' && /^[0-9]+$/.test(raw)) {
+    const value = Number(raw);
+    if (checks.pageSize(value)) return host.update(host.get().revision, { [key]: value });
+  }
   return { ok: false, code: 'INVALID', key };
 }
