+++ b/test/additions.test.mjs
@@ -0,0 +1,57 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHost } from '../src/host.mjs';
+import { endpoints } from '../src/bridges.mjs';
+import { labels, form } from '../src/renderer.mjs';
+import { edit } from '../src/cli.mjs';
+
+test('pageSize defaults to 25 with default provenance', () => {
+  const snapshot = createHost().get();
+  assert.equal(snapshot.values.pageSize, 25);
+  assert.equal(snapshot.origins.pageSize, 'default');
+});
+
+test('pageSize is exposed through ipc and gateway', () => {
+  const endpointsForHost = endpoints(createHost());
+  assert.equal(endpointsForHost.ipc('getSettings').values.pageSize, 25);
+  const update = { method: 'updateSettings', args: [0, { pageSize: 50 }] };
+  assert.equal(JSON.parse(endpointsForHost.gateway(update)).snapshot.values.pageSize, 50);
+});
+
+test('renderer renders Page size and 每页数量', () => {
+  const snapshot = createHost().get();
+  assert.deepEqual(labels.pageSize, { en: 'Page size', zh: '每页数量' });
+  assert.deepEqual(form(snapshot, 'en').find(field => field.key === 'pageSize').label, 'Page size');
+  assert.deepEqual(form(snapshot, 'zh').find(field => field.key === 'pageSize').label, '每页数量');
+});
+
+test('cli accepts inclusive and digit strings', () => {
+  for (const [raw, expected] of [['10', 10], ['25', 25], ['100', 100], ['050', 50]]) {
+    assert.equal(edit(createHost(), 'pageSize', raw).snapshot.values.pageSize, expected);
+  }
+});
+
+test('cli rejects partial numbers and out-of-range values without mutating state', () => {
+  for (const raw of ['10.5', 'abc', '1e2', ' 25', '', '9', '101', '-25', '0x10', '+50']) {
+    const host = createHost();
+    const result = edit(host, 'pageSize', raw);
+    assert.deepEqual(result, { ok: false, code: 'INVALID', key: 'pageSize' }, `raw ${raw}`);
+    assert.equal(host.persist().pageSize, undefined, `raw ${raw}`);
+    assert.equal(host.get().revision, 0, `raw ${raw}`);
+    assert.equal(host.get().values.pageSize, 25, `raw ${raw}`);
+    assert.equal(host.get().origins.pageSize, 'default', `raw ${raw}`);
+  }
+});
+
+test('rejection surfaces the error thrown by the injected host', () => {
+  const failing = { get: () => { throw new Error('host unavailable'); } };
+  assert.throws(() => edit(failing, 'pageSize', '50'), /host unavailable/);
+});
+
+test('verbose and unknown persisted keys are preserved', () => {
+  const host = createHost({ verbose: true, legacyKey: 'kept' });
+  assert.equal(edit(host, 'verbose', 'false').snapshot.values.verbose, false);
+  assert.equal(edit(host, 'pageSize', '50').snapshot.values.pageSize, 50);
+  assert.equal(edit(host, 'verbose', 'yes').code, 'INVALID');
+  assert.deepEqual(host.persist(), { verbose: false, legacyKey: 'kept', pageSize: 50 });
+});
