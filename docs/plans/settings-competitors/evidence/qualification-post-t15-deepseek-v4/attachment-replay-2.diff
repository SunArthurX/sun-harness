diff --git a/src/replay.mjs b/src/replay.mjs
index c831dac..605058a 100644
--- a/src/replay.mjs
+++ b/src/replay.mjs
@@ -3,12 +3,18 @@ export function replay(events, readAttachment) {
   for (const event of events) {
     if (event.type === 'assistant') messages.push({ role: 'assistant', text: event.text, images: [] });
     if (event.type !== 'user') continue;
-    try {
-      const images = (event.attachments ?? []).map(path => readAttachment(path));
-      messages.push({ role: 'user', text: event.text, images });
-    } catch (error) {
-      if (error.code !== 'ENOENT') throw error;
+    const images = [];
+    let missing = 0;
+    for (const path of event.attachments ?? []) {
+      try {
+        images.push(readAttachment(path));
+      } catch (error) {
+        if (error.code !== 'ENOENT') throw error;
+        missing += 1;
+      }
     }
+    const text = missing > 0 ? `${event.text}\n[Missing attachments: ${missing}]` : event.text;
+    messages.push({ role: 'user', text, images });
   }
   return messages;
 }
diff --git a/test/additions.test.mjs b/test/additions.test.mjs
new file mode 100644
index 0000000..a9a1ce4
--- /dev/null
+++ b/test/additions.test.mjs
@@ -0,0 +1,94 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { replay } from '../src/replay.mjs';
+
+const enoent = path => {
+  const error = new Error(`ENOENT: no such file, open '${path}'`);
+  error.code = 'ENOENT';
+  return error;
+};
+
+test('missing attachment keeps the user message and annotates the count', () => {
+  const messages = replay(
+    [{ type: 'user', text: 'hello', attachments: ['a'] }],
+    () => { throw enoent('a'); }
+  );
+  assert.deepEqual(messages, [
+    { role: 'user', text: 'hello\n[Missing attachments: 1]', images: [] }
+  ]);
+});
+
+test('missing attachments keep successful images in original order', () => {
+  const messages = replay(
+    [{ type: 'user', text: 'hi', attachments: ['a', 'b', 'c', 'd'] }],
+    path => {
+      if (path === 'b' || path === 'd') throw enoent(path);
+      return `image-${path}`;
+    }
+  );
+  assert.deepEqual(messages, [
+    {
+      role: 'user',
+      text: 'hi\n[Missing attachments: 2]',
+      images: ['image-a', 'image-c']
+    }
+  ]);
+});
+
+test('user and assistant events replay in order', () => {
+  const messages = replay(
+    [
+      { type: 'user', text: 'first', attachments: ['a'] },
+      { type: 'assistant', text: 'reply', images: [] },
+      { type: 'user', text: 'second', attachments: [] }
+    ],
+    () => { throw enoent('a'); }
+  );
+  assert.deepEqual(messages, [
+    { role: 'user', text: 'first\n[Missing attachments: 1]', images: [] },
+    { role: 'assistant', text: 'reply', images: [] },
+    { role: 'user', text: 'second', images: [] }
+  ]);
+});
+
+test('annotation never includes attachment paths or replacement bytes', () => {
+  const messages = replay(
+    [{ type: 'user', text: 'hello', attachments: ['/secret/dir/a.png'] }],
+    () => { throw enoent('/secret/dir/a.png'); }
+  );
+  assert.equal(messages[0].text, 'hello\n[Missing attachments: 1]');
+  assert.deepEqual(messages[0].images, []);
+});
+
+test('non-ENOENT reader errors propagate', () => {
+  const failure = new Error('EACCES: permission denied');
+  failure.code = 'EACCES';
+  assert.throws(
+    () => replay([{ type: 'user', text: 'hello', attachments: ['a'] }], () => { throw failure; }),
+    error => error === failure && error.code === 'EACCES'
+  );
+});
+
+test('unrelated event types are ignored', () => {
+  const messages = replay(
+    [
+      { type: 'system', text: 'boot' },
+      { type: 'user', text: 'hello', attachments: [] }
+    ],
+    () => { throw new Error('reader must not be called'); }
+  );
+  assert.deepEqual(messages, [{ role: 'user', text: 'hello', images: [] }]);
+});
+
+test('the event array is not mutated', () => {
+  const events = [
+    { type: 'user', text: 'hello', attachments: ['a', 'b'] },
+    { type: 'assistant', text: 'reply' }
+  ];
+  const snapshot = structuredClone(events);
+  replay(events, path => {
+    if (path === 'b') throw enoent(path);
+    return 'image';
+  });
+  assert.deepEqual(events, snapshot);
+});
