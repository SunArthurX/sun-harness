diff --git a/src/replay.mjs b/src/replay.mjs
index c831dac..605058a 100644
--- a/src/replay.mjs
+++ b/src/replay.mjs
@@ -3,12 +3,18 @@ export function replay(events, readAttachment) {
   for (const event of events) {
     if (event.type === 'assistant') messages.push({ role: 'assistant', text: event.text, images: [] });
     if (event.type !== 'user') continue;
-    try {
-      const images = (event.attachments ?? []).map(path => readAttachment(path));
-      messages.push({ role: 'user', text: event.text, images });
-    } catch (error) {
-      if (error.code !== 'ENOENT') throw error;
+    const images = [];
+    let missing = 0;
+    for (const path of event.attachments ?? []) {
+      try {
+        images.push(readAttachment(path));
+      } catch (error) {
+        if (error.code !== 'ENOENT') throw error;
+        missing += 1;
+      }
     }
+    const text = missing > 0 ? `${event.text}\n[Missing attachments: ${missing}]` : event.text;
+    messages.push({ role: 'user', text, images });
   }
   return messages;
 }
diff --git a/test/additions.test.mjs b/test/additions.test.mjs
new file mode 100644
index 0000000..8244935
--- /dev/null
+++ b/test/additions.test.mjs
@@ -0,0 +1,36 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { replay } from '../src/replay.mjs';
+
+test('keeps user message and successful images when one attachment is missing', () => {
+  const events = [
+    { type: 'assistant', text: 'hi', images: [] },
+    { type: 'user', text: 'see attached', attachments: ['a', 'b'] },
+  ];
+  const read = path => {
+    if (path === 'a') {
+      const error = new Error('missing');
+      error.code = 'ENOENT';
+      throw error;
+    }
+    return 'img';
+  };
+  assert.deepEqual(replay(events, read), [
+    { role: 'assistant', text: 'hi', images: [] },
+    { role: 'user', text: 'see attached\n[Missing attachments: 1]', images: ['img'] },
+  ]);
+  assert.equal(events[1].attachments.length, 2);
+  assert.equal(events[1].text, 'see attached');
+});
+
+test('propagates non-ENOENT reader errors', () => {
+  const read = () => {
+    const error = new Error('denied');
+    error.code = 'EACCES';
+    throw error;
+  };
+  assert.throws(
+    () => replay([{ type: 'user', text: 'x', attachments: ['a'] }], read),
+    /denied/,
+  );
+});
