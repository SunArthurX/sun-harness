diff --git a/src/replay.mjs b/src/replay.mjs
index c831dac..605058a 100644
--- a/src/replay.mjs
+++ b/src/replay.mjs
@@ -3,12 +3,18 @@ export function replay(events, readAttachment) {
   for (const event of events) {
     if (event.type === 'assistant') messages.push({ role: 'assistant', text: event.text, images: [] });
     if (event.type !== 'user') continue;
-    try {
-      const images = (event.attachments ?? []).map(path => readAttachment(path));
-      messages.push({ role: 'user', text: event.text, images });
-    } catch (error) {
-      if (error.code !== 'ENOENT') throw error;
+    const images = [];
+    let missing = 0;
+    for (const path of event.attachments ?? []) {
+      try {
+        images.push(readAttachment(path));
+      } catch (error) {
+        if (error.code !== 'ENOENT') throw error;
+        missing += 1;
+      }
     }
+    const text = missing > 0 ? `${event.text}\n[Missing attachments: ${missing}]` : event.text;
+    messages.push({ role: 'user', text, images });
   }
   return messages;
 }
diff --git a/test/additions.test.mjs b/test/additions.test.mjs
new file mode 100644
index 0000000..2558ad0
--- /dev/null
+++ b/test/additions.test.mjs
@@ -0,0 +1,92 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { replay } from '../src/replay.mjs';
+
+const enoent = () => Object.assign(new Error('missing'), { code: 'ENOENT' });
+
+function reader(map) {
+  return path => {
+    if (!(path in map)) throw enoent();
+    return map[path];
+  };
+}
+
+test('replays user and assistant events in order', () => {
+  const events = [
+    { type: 'user', text: 'hi', attachments: ['a'] },
+    { type: 'assistant', text: 'hello there', attachments: ['ignored'] },
+    { type: 'user', text: 'again' },
+  ];
+  assert.deepEqual(replay(events, reader({ a: 'imageA' })), [
+    { role: 'user', text: 'hi', images: ['imageA'] },
+    { role: 'assistant', text: 'hello there', images: [] },
+    { role: 'user', text: 'again', images: [] },
+  ]);
+});
+
+test('keeps user message and successful images in original order when some are missing', () => {
+  const events = [{ type: 'user', text: 'look', attachments: ['a', 'gone1', 'b', 'gone2'] }];
+  assert.deepEqual(replay(events, reader({ a: 'imageA', b: 'imageB' })), [
+    { role: 'user', text: 'look\n[Missing attachments: 2]', images: ['imageA', 'imageB'] },
+  ]);
+});
+
+test('appends missing marker with newline after empty user text', () => {
+  const events = [{ type: 'user', text: '', attachments: ['gone'] }];
+  assert.deepEqual(replay(events, reader({})), [
+    { role: 'user', text: '\n[Missing attachments: 1]', images: [] },
+  ]);
+});
+
+test('does not include paths or substitute bytes for missing attachments', () => {
+  const secret = '/home/user/secret-attachment.bin';
+  const result = replay([{ type: 'user', text: 'x', attachments: [secret] }], reader({}));
+  assert.equal(result.length, 1);
+  assert.deepEqual(result[0].images, []);
+  assert.ok(!JSON.stringify(result).includes(secret));
+  assert.equal(result[0].text, 'x\n[Missing attachments: 1]');
+});
+
+test('propagates non-ENOENT reader errors', () => {
+  const failure = Object.assign(new Error('permission denied'), { code: 'EACCES' });
+  const events = [
+    { type: 'user', text: 'one', attachments: ['ok'] },
+    { type: 'user', text: 'two', attachments: ['boom'] },
+  ];
+  const read = path => {
+    if (path === 'boom') throw failure;
+    return 'img';
+  };
+  assert.throws(() => replay(events, read), error => error === failure);
+});
+
+test('propagates non-ENOENT errors such as EISDIR', () => {
+  const failure = Object.assign(new Error('nope'), { code: 'EISDIR' });
+  assert.throws(() => replay([{ type: 'user', text: 'x', attachments: ['d'] }], () => { throw failure; }), error => error === failure);
+});
+
+test('ignores unrelated event types', () => {
+  const events = [
+    { type: 'system', text: 'sys', attachments: ['gone'] },
+    { type: 'tool', text: 'tool' },
+    { type: 'user', text: 'hi' },
+  ];
+  assert.deepEqual(replay(events, reader({})), [{ role: 'user', text: 'hi', images: [] }]);
+});
+
+test('does not mutate the events array or its events', () => {
+  const events = [
+    { type: 'user', text: 'hi', attachments: ['a', 'gone'] },
+    { type: 'assistant', text: 'yo' },
+  ];
+  const snapshot = structuredClone(events);
+  replay(events, reader({ a: 'img' }));
+  assert.deepEqual(events, snapshot);
+});
+
+test('intact replay is unchanged', () => {
+  const events = [{ type: 'user', text: 'hello', attachments: ['a'] }];
+  assert.deepEqual(replay(events, () => 'image'), [
+    { role: 'user', text: 'hello', images: ['image'] },
+  ]);
+});
