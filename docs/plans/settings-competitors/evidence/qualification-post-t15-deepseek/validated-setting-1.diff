+++ b/src/schema.mjs
@@ -1,2 +1,11 @@
-export const defaults = { verbose: false };
-export const checks = { verbose: value => typeof value === 'boolean' };
+export const defaults = { verbose: false, pageSize: 25 };
+
+// pageSize bounds from spec 032: inclusive integer range 10 through 100.
+export const pageSizeRange = { min: 10, max: 100 };
+
+export const checks = {
+  verbose: value => typeof value === 'boolean',
+  pageSize: value => Number.isInteger(value)
+    && value >= pageSizeRange.min
+    && value <= pageSizeRange.max,
+};
diff --git a/test/additions.test.mjs b/test/additions.test.mjs
