+import { pageSizeRange } from './schema.mjs';
+
 export function edit(host, key, raw) {
   if (key === 'verbose' && (raw === 'true' || raw === 'false')) {
     return host.update(host.get().revision, { [key]: raw === 'true' });
   }
+  // Decimal digit strings only: no sign, whitespace, fraction or exponent.
+  if (key === 'pageSize' && typeof raw === 'string' && /^[0-9]+$/.test(raw)) {
+    const value = Number(raw);
+    if (value < pageSizeRange.min || value > pageSizeRange.max) {
+      return { ok: false, code: 'INVALID', key };
+    }
+    return host.update(host.get().revision, { [key]: value });
+  }
   return { ok: false, code: 'INVALID', key };
 }
