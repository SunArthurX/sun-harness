+// Decimal digit strings only: no signs, fractions, exponents or whitespace.
+const decimalDigits = /^[0-9]+$/;
+
+export function parsePageSize(raw) {
+  if (typeof raw !== 'string' || !decimalDigits.test(raw)) return null;
+  // Reject digits that would exceed safe integer precision before coercing.
+  if (raw.replace(/^0+/, '').length > 15) return null;
+  return Number(raw);
+}
+
 export function edit(host, key, raw) {
   if (key === 'verbose' && (raw === 'true' || raw === 'false')) {
     return host.update(host.get().revision, { [key]: raw === 'true' });
   }
+  if (key === 'pageSize') {
+    const value = parsePageSize(raw);
+    if (value === null) return { ok: false, code: 'INVALID', key };
+    return host.update(host.get().revision, { [key]: value });
+  }
   return { ok: false, code: 'INVALID', key };
 }
