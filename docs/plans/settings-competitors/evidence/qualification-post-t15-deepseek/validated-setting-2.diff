+++ b/test/additions.test.mjs
@@ -0,0 +1,97 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHost } from '../src/host.mjs';
+import { endpoints } from '../src/bridges.mjs';
+import { edit } from '../src/cli.mjs';
+import { form, labels } from '../src/renderer.mjs';
+
+test('pageSize default is exposed through host, IPC and gateway', () => {
+  const host = createHost();
+  assert.equal(host.get().values.pageSize, 25);
+  assert.equal(host.get().origins.pageSize, 'default');
+  const { ipc, gateway } = endpoints(host);
+  assert.equal(ipc('getSettings').values.pageSize, 25);
+  assert.equal(JSON.parse(gateway({ method: 'getSettings', args: [] })).values.pageSize, 25);
+});
+
+test('pageSize 10 and 100 are inclusive bounds accepted by the host', () => {
+  const host = createHost();
+  assert.equal(edit(host, 'pageSize', '10').snapshot.values.pageSize, 10);
+  assert.equal(edit(host, 'pageSize', '100').snapshot.values.pageSize, 100);
+});
+
+test('CLI accepts decimal digit strings for pageSize', () => {
+  const host = createHost();
+  const result = edit(host, 'pageSize', '50');
+  assert.equal(result.ok, true);
+  assert.equal(result.snapshot.values.pageSize, 50);
+  assert.equal(result.snapshot.origins.pageSize, 'user');
+  assert.equal(result.snapshot.revision, 1);
+});
+
+test('CLI refuses partial numbers and out-of-range values without changing state', () => {
+  for (const raw of ['1.5', '1e2', '-20', '+50', ' 50', '50 ', '0x20', '', 'abc', '5a', 'infinity', 'NaN']) {
+    const host = createHost();
+    const before = host.get();
+    const result = edit(host, 'pageSize', raw);
+    assert.deepEqual(result, { ok: false, code: 'INVALID', key: 'pageSize' });
+    assert.deepEqual(host.get(), before);
+    assert.deepEqual(host.persist(), {});
+  }
+  for (const raw of ['9', '101', '0', '0009', '1000']) {
+    const host = createHost();
+    const result = edit(host, 'pageSize', raw);
+    assert.equal(result.ok, false);
+    assert.equal(result.code, 'INVALID');
+    assert.deepEqual(host.get(), { revision: 0, values: { verbose: false, pageSize: 25 }, origins: { verbose: 'default', pageSize: 'default' } });
+  }
+});
+
+test('pageSize edits survive IPC and gateway with revision check and persistence', () => {
+  const host = createHost();
+  const { ipc, gateway } = endpoints(host);
+  const stale = host.get().revision;
+  assert.equal(ipc('updateSettings', stale, { pageSize: 40 }).ok, true);
+  assert.equal(JSON.parse(gateway({ method: 'updateSettings', args: [stale, { pageSize: 60 }] })).code, 'CONFLICT');
+  assert.equal(JSON.parse(gateway({ method: 'updateSettings', args: [1, { pageSize: 60 }] })).snapshot.values.pageSize, 60);
+  assert.deepEqual(host.persist(), { pageSize: 60 });
+});
+
+test('host rejects non-integer pageSize values', () => {
+  const host = createHost();
+  for (const value of [10.5, '10', null, Number.NaN, true]) {
+    const result = host.update(0, { pageSize: value });
+    assert.equal(result.ok, false);
+    assert.equal(result.code, 'INVALID');
+  }
+  assert.equal(host.get().revision, 0);
+});
+
+test('renderer labels pageSize in English and Simplified Chinese', () => {
+  assert.equal(labels.pageSize.en, 'Page size');
+  assert.equal(labels.pageSize.zh, '每页数量');
+  const host = createHost();
+  edit(host, 'pageSize', '30');
+  const snapshot = host.get();
+  assert.deepEqual(form(snapshot, 'en').find(entry => entry.key === 'pageSize'), { key: 'pageSize', label: 'Page size', value: 30 });
+  assert.deepEqual(form(snapshot, 'zh').find(entry => entry.key === 'pageSize'), { key: 'pageSize', label: '每页数量', value: 30 });
+});
+
+test('saved pageSize and unknown persisted keys are preserved', () => {
+  const host = createHost({ pageSize: 75, legacyFlag: 'kept' });
+  const snapshot = host.get();
+  assert.equal(snapshot.values.pageSize, 75);
+  assert.equal(snapshot.origins.pageSize, 'user');
+  assert.equal(snapshot.values.verbose, false);
+  assert.deepEqual(host.persist(), { pageSize: 75, legacyFlag: 'kept' });
+  assert.equal(edit(host, 'pageSize', '9').ok, false);
+  assert.deepEqual(host.persist(), { pageSize: 75, legacyFlag: 'kept' });
+});
+
+test('verbose behavior is unchanged alongside pageSize', () => {
+  const host = createHost();
+  const result = edit(host, 'verbose', 'true');
+  assert.equal(result.snapshot.values.verbose, true);
+  assert.equal(result.snapshot.values.pageSize, 25);
+  assert.deepEqual(edit(host, 'verbose', 'yes'), { ok: false, code: 'INVALID', key: 'verbose' });
+});
