--- a/src/panel.mjs
+++ b/src/panel.mjs
@@ -2,12 +2,18 @@ import { labels } from './locale.mjs';
 
 export function render(status, locale) {
   if (status === 'unavailable') return { state: status, label: labels[locale].unavailable, actionEnabled: false };
+  if (status === 'denied') return { state: status, label: labels[locale].denied, actionEnabled: false };
   return { state: 'available', label: labels[locale].available, actionEnabled: true };
 }
 
 export async function capture(adapter, locale) {
   const state = render(adapter.status(), locale);
   if (!state.actionEnabled) return state;
-  await adapter.capture();
+  try {
+    await adapter.capture();
+  } catch (error) {
+    if (error && error.code === 'PERMISSION_DENIED') return render('denied', locale);
+    throw error;
+  }
   return state;
 }
diff --git a/test/additions.test.mjs b/test/additions.test.mjs
new file mode 100644
index 0000000..7a7170d
--- /dev/null
+++ b/test/additions.test.mjs
@@ -0,0 +1,88 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { render, capture } from '../src/panel.mjs';
+
+const deniedState = (locale) => ({
+  state: 'denied',
+  label: locale === 'en' ? 'Screen recording permission denied' : '屏幕录制权限被拒绝',
+  actionEnabled: false,
+});
+
+test('render denied returns the localized denial state in English', () => {
+  assert.deepEqual(render('denied', 'en'), deniedState('en'));
+});
+
+test('render denied returns the localized denial state in Chinese', () => {
+  assert.deepEqual(render('denied', 'zh'), deniedState('zh'));
+});
+
+test('capture does not call the adapter when status is denied', async () => {
+  let calls = 0;
+  const adapter = {
+    status: () => 'denied',
+    capture: async () => { calls += 1; },
+  };
+  const state = await capture(adapter, 'zh');
+  assert.equal(calls, 0);
+  assert.deepEqual(state, deniedState('zh'));
+});
+
+test('capture returns the denial state when the OS denies a capture after an available probe', async () => {
+  let calls = 0;
+  const adapter = {
+    status: () => 'available',
+    capture: async () => {
+      calls += 1;
+      const error = new Error('raw OS denial text must not surface');
+      error.code = 'PERMISSION_DENIED';
+      throw error;
+    },
+  };
+  const state = await capture(adapter, 'en');
+  assert.equal(calls, 1);
+  assert.deepEqual(state, deniedState('en'));
+  assert.equal(state.label.includes('raw OS denial text'), false);
+});
+
+test('capture rethrows other adapter failures', async () => {
+  const failure = new Error('adapter exploded');
+  failure.code = 'TIMEOUT';
+  const adapter = {
+    status: () => 'available',
+    capture: async () => { throw failure; },
+  };
+  await assert.rejects(() => capture(adapter, 'en'), (error) => error === failure);
+});
+
+test('capture rethrows failures without a PERMISSION_DENIED code', async () => {
+  const failure = new Error('plain failure');
+  const adapter = {
+    status: () => 'available',
+    capture: async () => { throw failure; },
+  };
+  await assert.rejects(() => capture(adapter, 'en'), (error) => error === failure);
+});
+
+test('available behavior is preserved', async () => {
+  let calls = 0;
+  const adapter = {
+    status: () => 'available',
+    capture: async () => { calls += 1; },
+  };
+  const en = await capture(adapter, 'en');
+  assert.deepEqual(en, { state: 'available', label: 'Capture window', actionEnabled: true });
+  const zh = await capture(adapter, 'zh');
+  assert.deepEqual(zh, { state: 'available', label: '捕获窗口', actionEnabled: true });
+  assert.equal(calls, 2);
+});
+
+test('unavailable behavior is preserved', async () => {
+  let calls = 0;
+  const adapter = {
+    status: () => 'unavailable',
+    capture: async () => { calls += 1; },
+  };
+  const state = await capture(adapter, 'en');
+  assert.deepEqual(state, { state: 'unavailable', label: 'Capture is unavailable', actionEnabled: false });
+  assert.equal(calls, 0);
+});
