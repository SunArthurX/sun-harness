diff --git a/src/panel.mjs b/src/panel.mjs
index 30a5d7c..671018b 100644
--- a/src/panel.mjs
+++ b/src/panel.mjs
@@ -2,12 +2,20 @@ import { labels } from './locale.mjs';
 
 export function render(status, locale) {
   if (status === 'unavailable') return { state: status, label: labels[locale].unavailable, actionEnabled: false };
+  if (status === 'denied') return { state: 'denied', label: labels[locale].denied, actionEnabled: false };
   return { state: 'available', label: labels[locale].available, actionEnabled: true };
 }
 
 export async function capture(adapter, locale) {
   const state = render(adapter.status(), locale);
   if (!state.actionEnabled) return state;
-  await adapter.capture();
+  try {
+    await adapter.capture();
+  } catch (error) {
+    // The OS refused permission mid-capture: surface the same denial state,
+    // never the raw error text.
+    if (error && error.code === 'PERMISSION_DENIED') return render('denied', locale);
+    throw error;
+  }
   return state;
 }
diff --git a/test/additions.test.mjs b/test/additions.test.mjs
new file mode 100644
index 0000000..a5bc2df
--- /dev/null
+++ b/test/additions.test.mjs
@@ -0,0 +1,84 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { render, capture } from '../src/panel.mjs';
+
+function makeAdapter(status, captureImpl = async () => {}) {
+  let calls = 0;
+  return {
+    status: () => status,
+    capture: async () => {
+      calls += 1;
+      return captureImpl();
+    },
+    calls: () => calls,
+  };
+}
+
+test('denied renders the bilingual denial state', () => {
+  assert.deepEqual(render('denied', 'en'), {
+    state: 'denied',
+    label: 'Screen recording permission denied',
+    actionEnabled: false,
+  });
+  assert.deepEqual(render('denied', 'zh'), {
+    state: 'denied',
+    label: '屏幕录制权限被拒绝',
+    actionEnabled: false,
+  });
+});
+
+test('denied status does not call capture', async () => {
+  const adapter = makeAdapter('denied');
+  const state = await capture(adapter, 'en');
+  assert.deepEqual(state, render('denied', 'en'));
+  assert.equal(adapter.calls(), 0);
+});
+
+test('available behavior is preserved and captures', async () => {
+  for (const locale of ['en', 'zh']) {
+    const adapter = makeAdapter('available');
+    const state = await capture(adapter, locale);
+    assert.deepEqual(state, render('available', locale));
+    assert.equal(state.actionEnabled, true);
+    assert.equal(adapter.calls(), 1);
+  }
+});
+
+test('unavailable behavior is preserved and does not capture', async () => {
+  for (const locale of ['en', 'zh']) {
+    const adapter = makeAdapter('unavailable');
+    const state = await capture(adapter, locale);
+    assert.deepEqual(state, render('unavailable', locale));
+    assert.equal(state.actionEnabled, false);
+    assert.equal(adapter.calls(), 0);
+  }
+});
+
+test('PERMISSION_DENIED during capture returns the denial state without raw error text', async () => {
+  for (const locale of ['en', 'zh']) {
+    const adapter = makeAdapter('available', async () => {
+      throw Object.assign(new Error('raw TCC violation text'), { code: 'PERMISSION_DENIED' });
+    });
+    const state = await capture(adapter, locale);
+    assert.deepEqual(state, render('denied', locale));
+    assert.equal(state.actionEnabled, false);
+    assert.equal(
+      JSON.stringify(state).includes('TCC'),
+      false,
+      'raw error text must not leak into the state',
+    );
+    assert.equal(adapter.calls(), 1);
+  }
+});
+
+test('other adapter failures still reject', async () => {
+  const adapter = makeAdapter('available', async () => {
+    throw Object.assign(new Error('capture backend crashed'), { code: 'CAPTURE_FAILED' });
+  });
+  await assert.rejects(capture(adapter, 'en'), /capture backend crashed/);
+
+  const plain = makeAdapter('available', async () => {
+    throw new Error('plain failure');
+  });
+  await assert.rejects(capture(plain, 'en'), /plain failure/);
+});
