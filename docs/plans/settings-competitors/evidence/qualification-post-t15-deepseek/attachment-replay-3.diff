@@ -3,12 +3,19 @@ export function replay(events, readAttachment) {
   for (const event of events) {
     if (event.type === 'assistant') messages.push({ role: 'assistant', text: event.text, images: [] });
     if (event.type !== 'user') continue;
-    try {
-      const images = (event.attachments ?? []).map(path => readAttachment(path));
-      messages.push({ role: 'user', text: event.text, images });
-    } catch (error) {
-      if (error.code !== 'ENOENT') throw error;
+    const images = [];
+    let missing = 0;
+    for (const path of event.attachments ?? []) {
+      try {
+        images.push(readAttachment(path));
+      } catch (error) {
+        if (error.code !== 'ENOENT') throw error;
+        missing += 1;
+      }
     }
+    // Paths stay out of the model-visible message; only the count is reported.
+    const text = missing === 0 ? event.text : `${event.text}\n[Missing attachments: ${missing}]`;
+    messages.push({ role: 'user', text, images });
   }
   return messages;
 }
diff --git a/test/additions.test.mjs b/test/additions.test.mjs
new file mode 100644
index 0000000..4c52f70
--- /dev/null
+++ b/test/additions.test.mjs
@@ -0,0 +1,82 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { replay } from '../src/replay.mjs';
+
+function reader(missing, values = {}) {
+  return path => {
+    if (missing.includes(path)) {
+      const error = new Error(`ENOENT: ${path}`);
+      error.code = 'ENOENT';
+      throw error;
+    }
+    return values[path] ?? `bytes:${path}`;
+  };
+}
+
+test('missing attachment keeps the user message and reports the count', () => {
+  const events = [{ type: 'user', text: 'hello', attachments: ['a'] }];
+  assert.deepEqual(replay(events, reader(['a'])), [
+    { role: 'user', text: 'hello\n[Missing attachments: 1]', images: [] },
+  ]);
+});
+
+test('successful images survive a missing neighbour in original order', () => {
+  const events = [{ type: 'user', text: 'see this', attachments: ['a', 'b', 'c'] }];
+  assert.deepEqual(replay(events, reader(['b'])), [
+    { role: 'user', text: 'see this\n[Missing attachments: 1]', images: ['bytes:a', 'bytes:c'] },
+  ]);
+});
+
+test('every missing attachment is counted and no path leaks into the message', () => {
+  const events = [{ type: 'user', text: 'both', attachments: ['/secret/one', '/secret/two', 'ok'] }];
+  const result = replay(events, reader(['/secret/one', '/secret/two']));
+  assert.deepEqual(result, [
+    { role: 'user', text: 'both\n[Missing attachments: 2]', images: ['bytes:ok'] },
+  ]);
+  assert.equal(result[0].text.includes('/secret'), false);
+});
+
+test('user and assistant events replay in order', () => {
+  const events = [
+    { type: 'assistant', text: 'first' },
+    { type: 'user', text: 'second', attachments: ['a', 'b'] },
+    { type: 'system', text: 'ignored' },
+    { type: 'assistant', text: 'third' },
+  ];
+  assert.deepEqual(replay(events, reader(['a'])), [
+    { role: 'assistant', text: 'first', images: [] },
+    { role: 'user', text: 'second\n[Missing attachments: 1]', images: ['bytes:b'] },
+    { role: 'assistant', text: 'third', images: [] },
+  ]);
+});
+
+test('non-ENOENT reader errors propagate', () => {
+  const events = [{ type: 'user', text: 'boom', attachments: ['a'] }];
+  assert.throws(
+    () => replay(events, () => {
+      const error = new Error('permission denied');
+      error.code = 'EACCES';
+      throw error;
+    }),
+    { code: 'EACCES' },
+  );
+});
+
+test('events array and intact replay are not mutated', () => {
+  const events = [
+    { type: 'user', text: 'hello', attachments: ['a'] },
+    { type: 'assistant', text: 'hi' },
+  ];
+  const snapshot = structuredClone(events);
+  assert.deepEqual(replay(events, reader([])), [
+    { role: 'user', text: 'hello', images: ['bytes:a'] },
+    { role: 'assistant', text: 'hi', images: [] },
+  ]);
+  assert.deepEqual(events, snapshot);
+});
+
+test('a user event without attachments is replayed unchanged', () => {
+  assert.deepEqual(replay([{ type: 'user', text: 'plain' }], reader([])), [
+    { role: 'user', text: 'plain', images: [] },
+  ]);
+});
