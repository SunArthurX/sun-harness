{
  "version": 1,
  "spec": "specs/032-settings-and-capability-management.md",
  "features": [
    {
      "id": "S01",
      "slug": "general",
      "label": "General",
      "group": "Personal",
      "decision": "adapt",
      "task": "T05",
      "reason": "Default model/mode, language and startup preferences; preserve existing configuration."
    },
    {
      "id": "S02",
      "slug": "notifications",
      "label": "Notifications",
      "group": "Personal",
      "decision": "adapt",
      "task": "T05",
      "reason": "Existing OS notifications gain event toggles, quiet hours and permission status."
    },
    {
      "id": "S03",
      "slug": "import",
      "label": "Import",
      "group": "Personal",
      "decision": "adapt",
      "task": "T06",
      "reason": "Existing JSONL import gains validation, dry-run summary and attachment-aware bundle import."
    },
    {
      "id": "S04",
      "slug": "profile",
      "label": "Profile",
      "group": "Personal",
      "decision": "adapt",
      "task": "T05",
      "reason": "Local USER.md profile; no public identity or social profile service."
    },
    {
      "id": "S05",
      "slug": "appearance",
      "label": "Appearance",
      "group": "Personal",
      "decision": "adapt",
      "task": "T05",
      "reason": "System/light/dark theme, text size and reduced motion."
    },
    {
      "id": "S06",
      "slug": "account",
      "label": "Account",
      "group": "Personal",
      "decision": "adapt",
      "task": "T02",
      "reason": "Provider credential readiness and endpoint identity; no sun hosted account."
    },
    {
      "id": "S07",
      "slug": "archived-chats",
      "label": "Archived chats",
      "group": "Personal",
      "decision": "adapt",
      "task": "T06",
      "reason": "Reuse flags, search and unarchive; archive is not deletion."
    },
    {
      "id": "S08",
      "slug": "parental-controls",
      "label": "Parental controls",
      "group": "Personal",
      "decision": "defer",
      "task": null,
      "reason": "Requires family identity, guardian consent and service operations; outside local single-owner scope."
    },
    {
      "id": "S09",
      "slug": "trusted-contact",
      "label": "Trusted contact",
      "group": "Personal",
      "decision": "defer",
      "task": null,
      "reason": "Requires account linkage and supported contact workflows; do not simulate by collecting a phone number."
    },
    {
      "id": "S10",
      "slug": "voice",
      "label": "Voice",
      "group": "Personal",
      "decision": "adapt",
      "task": "T05",
      "reason": "Existing transcription/read-aloud controls with push-to-record and provider readiness."
    },
    {
      "id": "S11",
      "slug": "storage",
      "label": "Storage",
      "group": "Personal",
      "decision": "new",
      "task": "T06",
      "reason": "Usage by resource, retention preview, resumable deletion and orphan detection."
    },
    {
      "id": "S12",
      "slug": "configuration",
      "label": "Configuration",
      "group": "Personal",
      "decision": "adapt",
      "task": "T02",
      "reason": "Validated transactional edits, effective values and source provenance."
    },
    {
      "id": "S13",
      "slug": "personalization",
      "label": "Personalization",
      "group": "Personal",
      "decision": "adapt",
      "task": "T05",
      "reason": "Rules, profile and memory controls with origins, limits and explicit edits."
    },
    {
      "id": "S14",
      "slug": "mini-pets",
      "label": "Mini & Pets",
      "group": "Personal",
      "decision": "adapt",
      "task": "T05",
      "reason": "Optional Mini status overlay; animated/custom pets deferred until asset/runtime spec exists."
    },
    {
      "id": "S15",
      "slug": "keyboard-shortcuts",
      "label": "Keyboard shortcuts",
      "group": "Personal",
      "decision": "new",
      "task": "T05",
      "reason": "Discoverable remappable app shortcuts, conflicts, reset; global capture shortcut in T11."
    },
    {
      "id": "S16",
      "slug": "usage-billing",
      "label": "Usage & billing",
      "group": "Personal",
      "decision": "adapt",
      "task": "T05",
      "reason": "Existing usage and estimated cost; unknown prices remain unknown; no fabricated provider invoices."
    },
    {
      "id": "S17",
      "slug": "data-controls",
      "label": "Data controls",
      "group": "Personal",
      "decision": "new",
      "task": "T06",
      "reason": "Export, retention and deletion; describe provider-bound data, do not promise provider-side deletion."
    },
    {
      "id": "S18",
      "slug": "plugins",
      "label": "Plugins",
      "group": "Integrations",
      "decision": "adapt",
      "task": "T07",
      "reason": "Existing local plugins/MCP gain readiness, trust, granted actions and failure diagnostics."
    },
    {
      "id": "S19",
      "slug": "passwords",
      "label": "Passwords",
      "group": "Integrations",
      "decision": "new",
      "task": "T13",
      "reason": "OS-backed credential references and private sign-in; no plaintext password model tool."
    },
    {
      "id": "S20",
      "slug": "computer-use",
      "label": "Computer use",
      "group": "Integrations",
      "decision": "new",
      "task": "T12",
      "reason": "Capability-gated native adapter, per-app grants, ownership, visible stop and takeover."
    },
    {
      "id": "S21",
      "slug": "appshots",
      "label": "Appshots",
      "group": "Integrations",
      "decision": "new",
      "task": "T11",
      "reason": "Explicit frontmost-window capture, preview, redact, attach and durable replay."
    },
    {
      "id": "S22",
      "slug": "browser",
      "label": "Browser",
      "group": "Integrations",
      "decision": "adapt",
      "task": "T10",
      "reason": "Profiles, tab ownership, origin/action permissions, download/upload and takeover."
    },
    {
      "id": "S23",
      "slug": "cloud-computer",
      "label": "Cloud computer",
      "group": "Integrations",
      "decision": "adapt",
      "task": "T14",
      "reason": "Bring-your-own execution target; local Docker labeled local, never marketed as hosted cloud."
    },
    {
      "id": "S24",
      "slug": "hooks",
      "label": "Hooks",
      "group": "Coding",
      "decision": "adapt",
      "task": "T07",
      "reason": "Existing lifecycle events; list source, validate, trust by digest, test fixtures and execution history."
    },
    {
      "id": "S25",
      "slug": "connections",
      "label": "Connections",
      "group": "Coding",
      "decision": "adapt",
      "task": "T08",
      "reason": "Existing pinned TLS gateway gains desktop connect, trust and device revoke controls."
    },
    {
      "id": "S26",
      "slug": "codex-cloud",
      "label": "Codex Cloud",
      "group": "Coding",
      "decision": "adapt",
      "task": "T14",
      "reason": "Name sun counterpart Remote jobs; no implied access to OpenAI subscription backend."
    },
    {
      "id": "S27",
      "slug": "code-review",
      "label": "Code Review",
      "group": "Coding",
      "decision": "adapt",
      "task": "T09",
      "reason": "Logged review input, structured findings, review rules and stale-diff detection."
    },
    {
      "id": "S28",
      "slug": "git",
      "label": "Git",
      "group": "Coding",
      "decision": "adapt",
      "task": "T09",
      "reason": "Repository status/base selection, diff and explicit actions through host."
    },
    {
      "id": "S29",
      "slug": "worktrees",
      "label": "Worktrees",
      "group": "Coding",
      "decision": "adapt",
      "task": "T09",
      "reason": "Existing worktree engine; inventory, ownership, setup trust, dirty/active cleanup guards."
    }
  ],
