{
  "name": "@sun/desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "description": "sun-harness desktop app",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "electron-vite build && electron-builder --mac --dir --publish never && node scripts/adhoc-sign.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sun/core": "workspace:*",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dompurify": "^3.4.17",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "marked": "^18.1.3",
    "playwright-core": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "dev.sun-harness.desktop",
    "productName": "sun-harness",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "45.2.3",
    "npmRebuild": false,
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "identity": null,
      "icon": "build/icon.png"
    }
  }
}
